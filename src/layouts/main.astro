---
import { url } from "@/lib/url"
import "@/styles/global.css"
import SiteNav from "@/components/site-nav.astro"
import PhaseStrip from "@/components/phase-strip.astro"
// Preloaded so the headings don't reflow when the fonts arrive
import archivoUrl from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url"
import serifItalicUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Dime un restaurante",
  description = "Restaurantes puntuados en lunas por Alberto de Luna desde 2010.",
} = Astro.props
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={serifItalicUrl}
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PUBLIC_PREVIEW && <meta name="robots" content="noindex" />}
    <script is:inline>
      // Hidden start states only apply when the animations will run
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion")
        try {
          if (sessionStorage.getItem("dime:intro-seen") === "1")
            document.documentElement.classList.add("intro-seen")
        } catch {}
      }
    </script>
  </head>
  <body>
    <SiteNav />
    <div class="cursor" data-cursor-dot aria-hidden="true">
      <span></span>
    </div>
    <slot />
    <footer class="site-footer">
      <PhaseStrip class="footer-phases" />
      <span>Dime un restaurante · Alberto de Luna</span>
      <span>Demo de Kaizencode</span>
    </footer>
    <script>
      import { initMotion } from "@/lib/animations"
      initMotion()
    </script>
  </body>
</html>

<style is:global>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 90;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: var(--glow);
    pointer-events: none;
    display: grid;
    place-items: center;
    color: var(--on-glow);
    font: 800 11px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: center;
    opacity: 0;
    transition:
      width 0.3s,
      height 0.3s,
      margin 0.3s;
  }
  .cursor span {
    opacity: 0;
    transition: opacity 0.2s;
  }
  .cursor.is-big {
    width: 110px;
    height: 110px;
    margin: -55px 0 0 -55px;
  }
  .cursor.is-big span {
    opacity: 1;
  }
  @media (hover: none), (pointer: coarse) {
    .cursor {
      display: none;
    }
  }
  .site-footer .footer-phases {
    flex-basis: 100%;
    margin-bottom: 28px;
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 40px 24px 32px;
    font: 600 12px/1.5 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey);
    background: var(--ink);
  }
</style>
