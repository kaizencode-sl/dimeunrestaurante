---
import { url } from "@/lib/url"
import type { GetStaticPaths } from "astro"
import Layout from "@/layouts/main.astro"
import { INSTAGRAM, reviewGraph } from "@/lib/seo"
import Moon from "@/components/moon.astro"
import ReviewRow from "@/components/review-row.astro"
import RollingScore from "@/components/rolling-score.astro"
import { HANDLE, SEAL_MIN, sealUrl } from "@/lib/seal"
import geo from "@/data/geo.json"
import dishPhotos from "@/data/dish-photos.json"
import {
  getReviews,
  formatScore,
  shortPlan,
  HOME_PICKS,
  type Review,
} from "@/lib/reviews"

export const getStaticPaths = (async () => {
  const reviews = await getReviews()
  return reviews.map((review) => ({
    params: { slug: review.id },
    props: { review, reviews },
  }))
}) satisfies GetStaticPaths

interface Props {
  review: Review
  reviews: Review[]
}

const { review, reviews } = Astro.props
const r = review.data

// The homepage picks have local photos; the rest still come from the old site
const local = HOME_PICKS.find((p) => p.id === review.id)
const photos = local
  ? local.photos.map((p) => url(`/img/home/${p}.jpg`))
  : r.images
// A dish that has its own photo shows it beside its line in the dish list,
// and that photo then leaves the gallery so it isn't shown twice
const dishMap: Record<string, string> =
  (dishPhotos as Record<string, Record<string, string>>)[review.id] ?? {}
const dishPhoto = (item: string) => {
  const text = item.toLowerCase()
  const key = Object.keys(dishMap).find((k) => text.includes(k))
  return key ? url(dishMap[key]!) : undefined
}
const inDishes = new Set(
  r.body.flatMap((b) =>
    b.type === "list" ? b.items.map(dishPhoto).filter(Boolean) : []
  )
)
const [cover, ...gallery] = photos.filter(
  (src, i) => i === 0 || !inDishes.has(src)
)

// Photos go into the text instead of piling up at the end: roughly one
// moment every three paragraphs, alternating a wide photo and a pair. What
// doesn't fit in the text closes the review as a strip you can swipe.
type Moment = { kind: "wide" | "pair"; photos: string[] }
const paragraphs = r.body
  .map((b, i) => (b.type === "p" && i > 0 ? i : -1))
  .filter((i) => i >= 0 && i < r.body.length - 1)
const moments: Moment[] = []
let used = 0
const slots = Math.min(4, Math.floor(paragraphs.length / 3))
for (let k = 0; k < slots && used < gallery.length; k++) {
  const kind = k % 2 === 0 || gallery.length - used < 2 ? "wide" : "pair"
  const take = kind === "wide" ? 1 : 2
  moments.push({ kind, photos: gallery.slice(used, used + take) })
  used += take
}
// Block index → the moment shown after it, spread evenly through the text
const after = new Map(
  moments.map((m, k) => [
    paragraphs[
      Math.floor(((k + 1) * paragraphs.length) / (moments.length + 1))
    ],
    m,
  ])
)
const rest = gallery.slice(used, 16)

const visit = r.visit
  ? r.visit.toLowerCase().replace(/^./, (c) => c.toUpperCase())
  : null
const chips = [...r.plans.map(shortPlan), ...r.venue, ...r.cuisine]

const related = reviews
  .filter(
    (o) =>
      o.id !== review.id && o.data.city === r.city && o.data.images.length >= 4
  )
  .sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
  .slice(0, 3)

const point = (
  geo as Record<string, { lat: number; lon: number; approx?: boolean }>
)[review.id]
const onMap = point && !point.approx && r.score !== null
const hasSeal = (r.score ?? 0) >= SEAL_MIN

// Reviews that are also on Instagram link to Alberto's posts
const ig = r.instagram
const igDate = ig?.date
  ? new Intl.DateTimeFormat("es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(ig.date))
  : null

const description =
  r.excerpt || `${r.name}: ${r.headline}. ${formatScore(r.score)} lunas.`

// Shared as its cover photo, or a card with its moon when it has none
const shareImage = cover ?? `/og/${review.id}.png`
const jsonLd = reviewGraph(review, {
  image: cover,
  geo: point && !point.approx ? point : null,
})
---

<Layout
  title={`${r.name}, ${r.city} · Dime un restaurante`}
  description={description}
  type="article"
  image={shareImage}
  imageAlt={
    cover ? `Plato en ${r.name}` : `${r.name}: ${formatScore(r.score)} lunas`
  }
  jsonLd={jsonLd}
>
  <main>
    <header class="head" data-review-head data-score={r.score ?? ""}>
      <div class="media" data-review-media>
        {cover ? (
          <img src={cover} alt={`Plato en ${r.name}`} fetchpriority="high" />
        ) : (
          <div class="no-photo">
            <Moon score={r.score ?? 10} glow class="no-photo-moon" />
          </div>
        )}
      </div>
      <div class="head-inner">
        <a class="back" href={url("/restaurantes")}>
          ← Todas las reseñas
        </a>
        <div class="head-bottom">
          <div class="title">
            <span class="eyebrow">{r.city}</span>
            <h1 data-review-name class:list={{ long: r.name.length > 16 }}>
              {r.name}
            </h1>
            {r.headline && <p class="headline">“{r.headline}”</p>}
          </div>
          {r.score === null ? (
            <div class="score unscored">
              <Moon score={0} class="score-moon" />
              <span class="score-num">
                <small>Sin puntuar</small>
              </span>
            </div>
          ) : (
            <div class="score" aria-label={`${formatScore(r.score)} lunas`}>
              <Moon score={r.score} animated class="score-moon" />
              <span class="score-num">
                <RollingScore score={r.score} />
                <small>lunas</small>
              </span>
            </div>
          )}
        </div>
      </div>
    </header>

    <dl class="facts" data-review-meta>
      {r.paid && (
        <div>
          <dt>Yo pagué</dt>
          <dd>{r.paid}</dd>
        </div>
      )}
      {r.avgPrice && (
        <div>
          <dt>Precio medio</dt>
          <dd>{r.avgPrice}</dd>
        </div>
      )}
      {visit && (
        <div>
          <dt>Visita</dt>
          <dd>{visit}</dd>
        </div>
      )}
      {r.address.length > 0 && (
        <div class="wide-fact">
          <dt>Dónde</dt>
          <dd>
            {r.address.map((line) => (
              <span>{line}</span>
            ))}
            {onMap && (
              <a class="map-link" href={url(`/mapa?r=${review.id}`)}>
                Ver en el mapa →
              </a>
            )}
          </dd>
        </div>
      )}
    </dl>

    <article class="body">
      {chips.length > 0 && (
        <ul class="chips" aria-label="Etiquetas">
          {chips.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      )}
      <div class="text" data-gallery>
        {r.body.map((block, i) => [
          block.type === "p" ? (
            <p data-reveal>{block.text}</p>
          ) : block.type === "h" ? (
            <h2 class="update" data-reveal>
              {block.text}
            </h2>
          ) : (
            <ol class="dishes" data-reveal>
              {block.items.map((item) => {
                const src = dishPhoto(item)
                return (
                  <li class:list={{ "has-photo": src }}>
                    <span>{item}</span>
                    {src && (
                      <button
                        type="button"
                        class="dish-photo"
                        data-full={src}
                        data-caption={item}
                        aria-label={`Ampliar foto: ${item}`}
                      >
                        <img
                          src={src.replace("/img/ig/", "/img/ig/thumb/")}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          width="112"
                          height="112"
                        />
                      </button>
                    )}
                  </li>
                )
              })}
            </ol>
          ),
          after.has(i) && (
            <div class:list={["moment", after.get(i)!.kind]}>
              {after.get(i)!.photos.map((src) => (
                <figure data-wipe>
                  <img
                    src={src}
                    alt={`Foto de ${r.name}`}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          ),
        ])}
        {ig && (
          <aside class="ig-card" aria-label="En Instagram">
            <p class="ig-eyebrow">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.3" cy="6.7" r="1" class="dot" />
              </svg>
              <span>
                También en Instagram
                {igDate && ` · ${igDate}`}
              </span>
            </p>
            <p class="ig-title">
              Comenta la visita en{" "}
              <a href={INSTAGRAM} target="_blank" rel="noopener">
                {HANDLE}
              </a>
            </p>
            <ul class="ig-posts">
              {ig.posts.map((p, i) => (
                <li>
                  <a href={p.url} target="_blank" rel="noopener">
                    <span class="ig-kind">
                      {p.kind === "opinion"
                        ? "La opinión"
                        : p.kind === "dishes"
                          ? "Los platos"
                          : `Post ${i + 1}`}
                    </span>
                    <span class="ig-go">
                      Ver post <span aria-hidden="true">↗</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            {ig.handle && (
              <p class="ig-place">
                {r.name} en Instagram:{" "}
                <a
                  href={`https://www.instagram.com/${ig.handle}/`}
                  target="_blank"
                  rel="noopener"
                >
                  @{ig.handle}
                </a>
              </p>
            )}
          </aside>
        )}
      </div>
    </article>

    {rest.length > 0 && (
      <section class="gallery" data-gallery aria-label="Más fotos">
        <p class="gallery-label">
          Más fotos <span>{rest.length}</span>
          <span class="gallery-hint" aria-hidden="true">
            Desliza →
          </span>
        </p>
        <div class="gallery-strip">
          {rest.map((src) => (
            <figure data-wipe>
              <img
                src={src}
                alt={`Foto de ${r.name}`}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    {hasSeal && (
      <aside class="seal-cta">
        <img
          src={sealUrl(review.id)}
          alt=""
          width="400"
          height="400"
          loading="lazy"
        />
        <div>
          <span class="eyebrow">¿Es tu restaurante?</span>
          <p>Luce tus {formatScore(r.score)} lunas en la puerta y en tu web.</p>
          <a href={url(`/sello/${review.id}`)}>Consigue el sello →</a>
        </div>
      </aside>
    )}

    {related.length > 0 && (
      <section class="related" aria-label={`Más en ${r.city}`}>
        <h2 data-chars>Más en {r.city}</h2>
        <div class="rows">
          {related.map((o, i) => (
            <ReviewRow review={o} index={i} photos={o.data.images} />
          ))}
        </div>
      </section>
    )}
  </main>

  {inDishes.size > 0 && (
    <dialog class="viewer" data-viewer aria-label="Foto del plato">
      <figure>
        <img alt="" />
        <figcaption />
      </figure>
      <button type="button" class="viewer-close" aria-label="Cerrar">
        ×
      </button>
    </dialog>
  )}
</Layout>

<script>
  // A dish thumbnail opens its photo full size; a click anywhere or Esc closes it
  const viewer = document.querySelector<HTMLDialogElement>("[data-viewer]")
  if (viewer) {
    const img = viewer.querySelector("img")!
    const caption = viewer.querySelector("figcaption")!
    document
      .querySelectorAll<HTMLButtonElement>(".dish-photo")
      .forEach((button) =>
        button.addEventListener("click", () => {
          img.src = button.dataset.full!
          img.alt = button.dataset.caption ?? ""
          caption.textContent = button.dataset.caption ?? ""
          viewer.showModal()
        })
      )
    viewer.addEventListener("click", () => viewer.close())
  }
</script>

<style>
  .head {
    position: relative;
    height: 100svh;
    min-height: 600px;
    background: var(--stage);
    overflow: hidden;
  }
  .media {
    position: absolute;
    inset: 0;
  }
  .media img,
  .no-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* No photo: a night sky with the restaurant's moon hanging in it */
  .no-photo {
    position: relative;
    background:
      radial-gradient(circle at 70% 32%, #2a2620, transparent 45%), var(--stage);
  }
  .no-photo :global(.no-photo-moon) {
    position: absolute;
    top: 14%;
    left: 62%;
    width: min(34vmin, 320px);
    height: auto;
    opacity: 0.85;
  }
  .unscored :global(.score-moon) {
    --moon-base: transparent;
    --moon-ring: rgb(255 255 255 / 45%);
  }
  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 30%),
      transparent 30%,
      rgb(0 0 0 / 70%)
    );
  }
  .head-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 84px 24px 40px;
    color: #fff;
  }
  .back {
    align-self: flex-start;
    font: 600 12px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: inherit;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .head-bottom {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
  }
  .title {
    min-width: 0;
  }
  .title .eyebrow {
    color: #fff;
  }
  h1 {
    margin: 10px 0 0;
    font: 900 clamp(56px, 11vw, 200px) / 0.82 var(--font-display);
    font-stretch: 118%;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }
  h1.long {
    font-size: clamp(44px, 7.5vw, 140px);
  }
  .headline {
    margin: 16px 0 0;
    max-width: 40ch;
    font: italic 400 clamp(22px, 2.4vw, 34px) / 1.1 var(--font-serif);
  }
  .score {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }
  .score :global(.score-moon) {
    width: clamp(90px, 10vw, 150px);
    height: auto;
    --moon-base: rgb(0 0 0 / 45%);
  }
  .score-num {
    font: 800 clamp(64px, 8vw, 130px) / 0.8 var(--font-display);
    font-stretch: 62%;
    font-variant-numeric: tabular-nums;
    color: var(--moon);
  }
  .score-num small {
    display: block;
    margin-top: 6px;
    font: 700 12px/1 var(--font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 56px;
    margin: 0;
    padding: 28px 24px;
    background: var(--glow);
    color: var(--ink);
  }
  .facts dt {
    font: 700 11px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .facts dd {
    margin: 8px 0 0;
    font: 800 clamp(22px, 2.2vw, 32px) / 1.05 var(--font-display);
    font-stretch: 88%;
  }
  .facts dd span {
    display: block;
  }
  .wide-fact dd {
    font-size: clamp(17px, 1.4vw, 20px);
    font-stretch: 100%;
    font-weight: 600;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(0, 680px) 1fr;
    gap: 40px;
    padding: 12vh 24px;
    background: var(--paper);
    color: var(--ink);
  }
  .chips {
    grid-column: 1;
    align-self: start;
    position: sticky;
    top: 90px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    border: 1.5px solid var(--ink);
    border-radius: 99px;
    padding: 6px 11px 5px;
    font: 700 11px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .text {
    grid-column: 2;
    font: 400 clamp(18px, 1.35vw, 21px) / 1.6 var(--font-sans);
  }
  .text p {
    margin: 0 0 1.1em;
  }
  .text .update {
    margin: 2.2em 0 0.9em;
    padding-top: 1.1em;
    border-top: 2px solid var(--ink);
    font: 900 clamp(22px, 2vw, 30px) / 1.05 var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  /* Where the review came from: Alberto's posts and the restaurant's account */
  .ig-card {
    margin-top: 2.6em;
    padding-top: 1.1em;
    border-top: 2px solid var(--ink);
  }
  .text .ig-eyebrow {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0 0 0.7em;
    font: 600 12px/1.5 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .ig-eyebrow svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--glow-text);
    stroke-width: 1.8;
  }
  .ig-eyebrow .dot {
    fill: var(--glow-text);
    stroke: none;
  }
  .text .ig-title {
    margin: 0 0 1em;
    font: 900 clamp(22px, 2vw, 30px) / 1.08 var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .ig-title a,
  .ig-place a {
    color: var(--glow-text);
    text-decoration: none;
  }
  .ig-title a:hover,
  .ig-place a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .ig-posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ig-posts a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 14px 16px;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .ig-posts a:hover,
  .ig-posts a:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }
  .ig-kind {
    font: 800 17px/1.1 var(--font-display);
    font-stretch: 112%;
  }
  .ig-go {
    font: 600 11px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .text .ig-place {
    margin: 1em 0 0;
    font: 600 13px/1.5 var(--font-display);
    color: var(--ink-soft);
  }
  .text p:first-child::first-letter {
    float: left;
    margin: 0.06em 0.08em 0 0;
    font: 900 4.6em/0.8 var(--font-display);
    font-stretch: 118%;
    color: var(--glow-text);
  }
  .dishes {
    margin: 1.4em 0 1.6em;
    padding: 0;
    list-style: none;
    counter-reset: dish;
    border-top: 2px solid var(--ink);
  }
  .dishes li {
    counter-increment: dish;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .dishes li::before {
    content: counter(dish, decimal-leading-zero);
    font: 800 14px/1.9 var(--font-display);
    color: var(--glow-text);
    font-variant-numeric: tabular-nums;
  }
  .dishes li.has-photo {
    grid-template-columns: 44px 1fr 112px;
    align-items: center;
  }
  .dishes li.has-photo::before {
    align-self: start;
  }
  .dish-photo {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 6px;
    cursor: zoom-in;
  }
  .dish-photo img {
    transition: transform 0.3s ease;
  }
  .dish-photo:hover img {
    transform: scale(1.04);
  }
  .dish-photo:focus-visible {
    outline: 2px solid var(--glow-text);
    outline-offset: 3px;
  }
  .viewer {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .viewer::backdrop {
    background: rgb(10 10 12 / 0.88);
  }
  .viewer[open] {
    display: grid;
    place-items: center;
    animation: viewer-in 0.25s ease-out;
  }
  @keyframes viewer-in {
    from {
      opacity: 0;
    }
  }
  .viewer figure {
    margin: 0;
    display: grid;
    gap: 14px;
    justify-items: center;
    padding: 16px;
  }
  .viewer img {
    max-width: min(92vw, 1100px);
    max-height: calc(100dvh - 120px);
    object-fit: contain;
    border-radius: 6px;
  }
  .viewer figcaption {
    max-width: 60ch;
    color: #f3ede2;
    font-size: 15px;
    text-align: center;
  }
  .viewer-close {
    position: fixed;
    top: 14px;
    right: 18px;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    color: #f3ede2;
    font-size: 34px;
    line-height: 1;
    cursor: pointer;
  }
  .dishes img {
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--photo-bg);
  }
  @media (max-width: 600px) {
    .dishes li.has-photo {
      grid-template-columns: 32px 1fr 76px;
    }
    .dishes img {
      width: 76px;
      height: 76px;
    }
  }

  /* Photos inside the text */
  .moment {
    margin: 2.2em 0 2.4em;
    display: grid;
    gap: 8px;
