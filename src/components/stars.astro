---
/**
 * A night sky for the dark sections, drawn on canvas in three depths: a dust
 * of faint stars, a middle layer and a few bright ones with a soft glow.
 * Stars have slightly different colours (blue-white to amber), a faint band of
 * denser sky crosses it like the Milky Way, the bright ones twinkle, a
 * shooting star passes now and then, and the layers drift at different speeds
 * with the scroll. Positions come from a seed, so every visit draws the same
 * sky (the loader and the hero share one, so the fade between them is seamless).
 */
interface Props {
  /** How busy the sky is, 60 being the default */
  count?: number
  seed?: number
  class?: string
}

const { count = 60, seed = 7, class: className } = Astro.props
---

<div
  class:list={["stars", className]}
  aria-hidden="true"
  data-stars
  data-seed={seed}
  data-density={count / 60}
>
  <canvas data-depth="far"></canvas>
  <canvas data-depth="mid"></canvas>
  <canvas data-depth="near"></canvas>
</div>

<script>
  import { initStars } from "@/lib/stars"
  initStars()
</script>

<style>
  .stars {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  canvas {
    position: absolute;
    left: 0;
    /* Taller than the sky so the layers can drift without showing an edge */
    top: -12%;
    width: 100%;
    height: 124%;
    will-change: transform;
  }
</style>
