---
import ScoreStamp from "@/components/score-stamp.astro"
import { reviewUrl, shortPlan, type Review } from "@/lib/reviews"

interface Props {
  review: Review
  index: number
  /** Photo URLs; the first four are shown */
  photos: string[]
}

const { review, index, photos } = Astro.props
const r = review.data
const tags = [...r.plans.map(shortPlan), ...r.venue].slice(0, 2)
---

<a
  class="row"
  href={reviewUrl(review.id)}
  data-row
  data-cursor="Ver reseña"
  data-plans={[...r.plans, ...r.venue, ...r.cuisine].join("|")}
>
  <div class="row-top" data-row-top>
    <span class="row-idx">{String(index + 1).padStart(2, "0")}</span>
    <h3 class="row-name">
      {r.name}
      <span class="row-head">“{r.headline}”</span>
    </h3>
    <ScoreStamp score={r.score} />
  </div>
  <div class="strip">
    {photos.slice(0, 4).map((src) => (
      <figure data-wipe>
        <img src={src} alt="" loading="lazy" decoding="async" />
      </figure>
    ))}
  </div>
  <div class="row-foot">
    {r.visit && (
      <span>{r.visit.toLowerCase().replace(/^./, (c) => c.toUpperCase())}</span>
    )}
    {r.paid && <span>Yo pagué {r.paid}</span>}
    {tags.length > 0 && <span>{tags.join(" · ")}</span>}
  </div>
</a>

<style>
  .row {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .row-top {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: end;
    border-top: 2px solid var(--ink);
    padding-top: 14px;
    margin-bottom: 14px;
  }
  .row-idx {
    font: 700 14px/1 var(--font-display);
    color: var(--grey);
    font-variant-numeric: tabular-nums;
  }
  .row-name {
    margin: 0;
    font: 900 clamp(30px, 4vw, 64px) / 0.9 var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .row-head {
    display: block;
    margin-top: 6px;
    font: italic 400 clamp(18px, 1.6vw, 24px) / 1.15 var(--font-serif);
    text-transform: none;
    letter-spacing: 0;
    color: var(--grey);
  }
  .strip {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    gap: 6px;
    height: clamp(180px, 24vw, 360px);
  }
  .strip figure {
    margin: 0;
    overflow: hidden;
    border-radius: 3px;
    background: var(--photo-bg);
  }
  .strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .row:hover .strip img {
    transform: scale(1.07);
  }
  .row-foot {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 12px;
    font: 600 12px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--grey);
  }
  @media (max-width: 800px) {
    .row-top {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
      gap: 12px;
    }
    .row-idx {
      display: none;
    }
    .row-name {
      font-size: 9vw;
      overflow-wrap: break-word;
    }
    .strip {
      grid-template-columns: repeat(4, 1fr);
      height: 34vw;
    }
  }
</style>
